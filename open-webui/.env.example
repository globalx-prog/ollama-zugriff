# Open WebUI Environment Configuration Example
# Copy this file to .env and adjust the values:
# cp .env.example .env && chmod 600 .env

# Image version pin (e.g., v0.11.4)
OWUI_VERSION=v0.11.4

# Static Secret Key for JWT sessions (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
